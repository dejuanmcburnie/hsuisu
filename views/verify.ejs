<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Enter verification code</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="card">
    <h1>Enter your code</h1>
    <p class="subtitle">We sent a 6-digit code to <strong><%= email %></strong>.</p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/verify">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label for="code">Verification code</label>
      <input type="text" id="code" name="code" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="123456" required autofocus />
      <button type="submit">Verify &amp; get device key</button>
    </form>
    <p class="meta"><a href="/signup">Use a different email or resend code</a></p>
  </div>
</body>
</html>
