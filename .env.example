# --- Headscale backend (server-side only, never sent to the browser) ---
HEADSCALE_URL=https://headscale.internal.example.com
HEADSCALE_API_KEY=changeme-create-with-`headscale apikeys create`
# Optional: hostname shown in the `tailscale up --login-server=` instructions,
# if it differs from HEADSCALE_URL (e.g. different external vs internal name).
# TAILSCALE_LOGIN_SERVER=https://headscale.example.com

# --- Signup gating ---
ALLOWED_EMAIL_DOMAINS=yourcompany.com
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
PREAUTHKEY_TTL_MINUTES=60
PREAUTHKEY_EPHEMERAL=false
PREAUTHKEY_REUSABLE=false

# --- SMTP (for sending OTP codes) ---
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=changeme
SMTP_FROM="Device Enrollment <enroll@yourcompany.com>"

# --- App ---
PORT=3000
APP_BASE_URL=https://enroll.yourcompany.com
SESSION_SECRET=change-me-to-a-long-random-string
STORE_PATH=./data/signup.json

# Optional link shown on the success page (e.g. gurucomputing/headscale-ui)
# ADMIN_UI_URL=https://admin.yourcompany.com
